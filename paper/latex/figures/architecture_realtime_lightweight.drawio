        <mxCell id="title" value="Real-Time Agentic Lightweight Fuzzy Consensus Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Fast path runs at every control tick; LangGraph/Gemma supervision is event-triggered and always verified before actuation." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=left;verticalAlign=middle;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="24" as="geometry"/>
