# Optional Kaggle credentials for datasets that require authenticated download.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional local OpenAI-compatible vLLM endpoint.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=google/gemma-4-12B-it

# Dataset download behavior.
ALLOW_DATASET_DOWNLOADS=false
